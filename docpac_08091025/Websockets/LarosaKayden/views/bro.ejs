<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BRO</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            text-align: center;
            transition: background-color 0.5s, color 0.5s;
            background: linear-gradient(135deg, #072438 30%, #000c15 100%);
            color: white;
            height: 100vh;
            overflow: hidden;
        }

        /* === HEADER === */
        #formbarHeader {
            /* position and size */
            position: absolute;
            top: 0;
            left: 15px;
            right: 15px;
            height: 60px;
            border-radius: 0 0 12px 12px;

            /* layout inside */
            display: flex;
            align-items: center;
            justify-content: left;
            padding: 0 20px;

            /* style */
            font-size: 19px;
            color: white;
            background: linear-gradient(to right, #002a7a, #4b00a5);
            box-shadow: 0 3px 10px black;
            z-index: 5;
        }

        /* overlay for depth */
        #formbarHeader::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.15);
            pointer-events: none;
            border-radius: 0 0 12px 12px;
            z-index: 0;
        }

        /* === HEADER TEXT === */
        #headerLogo {
            display: flex;
            align-items: baseline;
            font-family: "Outfit", sans-serif;
            gap: 10px;
            z-index: 1;
        }

        #headerLogo h1 {
            margin: 0;
            font-size: 40px;
            /* slightly match original */
            font-weight: 700;
            letter-spacing: 0.5px;
            /* smooth appearance */
            color: #ffffff;
            filter: brightness(1.1);
            text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
        }

        #headerLogo p {
            margin: 0;
            font-size: 14px;
            color: #fffa;
        }

        /* === Chat stuff === */

    </style>
</head>

<body>
    <!-- HEADER -->
    <div id="formbarHeader">
        <div id="headerLogo">
            <h1>Formchat</h1>
            <p>v 0.0.pirate</p>
        </div>
    </div>

    <!-- Main Content -->
    <main id="chat-container">
        <aside id="chat-sidebar">
            <h2>Chat Rooms</h2>
        </aside>
    </main>

</body>

</html>