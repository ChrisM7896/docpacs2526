<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formchat</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            text-align: center;
            transition: background-color 0.5s, color 0.5s;
            background: linear-gradient(135deg, #072438 30%, #000c15 100%);
            color: white;
            height: 100vh;
            overflow: hidden;
        }

        /* === HEADER === */
        #formbarHeader {
            /* position and size */
            position: absolute;
            top: 0;
            left: 15px;
            right: 15px;
            height: 60px;
            border-radius: 0 0 12px 12px;

            /* layout inside */
            display: flex;
            align-items: center;
            justify-content: left;
            padding: 0 20px;

            /* style */
            font-size: 19px;
            color: white;
            background: linear-gradient(to right, #002a7a, #4b00a5);
            box-shadow: 0 3px 10px black;
            z-index: 5;
        }

        /* overlay for depth */
        #formbarHeader::before {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.15);
            pointer-events: none;
            border-radius: 0 0 12px 12px;
            z-index: 0;
        }

        /* === HEADER TEXT === */
        #headerLogo {
            display: flex;
            align-items: baseline;
            font-family: "Outfit", sans-serif;
            gap: 10px;
            z-index: 1;
        }

        #headerLogo h1 {
            margin: 0;
            font-size: 40px;
            /* slightly match original */
            font-weight: 700;
            letter-spacing: 0.5px;
            /* smooth appearance */
            color: #ffffff;
            filter: brightness(1.1);
            text-shadow: 0 1px 0 rgba(0, 0, 0, 0.25);
        }

        #headerLogo p {
            margin: 0;
            font-size: 14px;
            color: #fffa;
        }

        /* === Chat stuff === */
        main {
            display: flex;
            flex: 1;
            margin-top: 70px;
            height: calc(100vh - 70px);
            overflow: hidden;
        }

        /* Sidebar */
        #chat-sidebar {
            width: 250px;
            background: rgba(255, 255, 255, 0.07);
            border-right: 2px solid rgba(255, 255, 255, 0.1);
            padding: 20px;
            box-sizing: border-box;
        }

        #chat-sidebar h2 {
            font-size: 20px;
            margin-bottom: 15px;
        }

        /* Chat area */
        #chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 15px;
            box-sizing: border-box;
        }

        /* Container for each message row */
        .message-row {
            display: flex;
            margin: 6px 0;
        }

        .message-row.you {
            justify-content: flex-end;
            /* push to right */
        }

        .message-row.other {
            justify-content: flex-start;
            /* push to left */
        }

        /* Chat bubble itself */
        .message {
            max-width: 65%;
            padding: 10px 14px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: white;
            word-wrap: break-word;
        }

        /* Your messages (right side) */
        .message-row.you .message {
            background: linear-gradient(135deg, #4b00a5, #002a7a);
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-align: right;
        }

        /* Other people's messages (left side) */
        .message-row.other .message {
            background: rgba(255, 255, 255, 0.08);
            text-align: left;
        }

        /* Chat input area */
        #inputBar {
            display: flex;
            border-radius: 12px;
            overflow: hidden;
            background: #0d2033;
            border: 1px solid #22394f;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
        }

        #msg {
            flex: 1;
            padding: 12px;
            border: none;
            background: transparent;
            color: white;
            font-size: 16px;
            outline: none;
        }

        #send {
            background: #132b45;
            border: 1px solid #33577b;
            color: white;
            font-size: 16px;
            font-weight: 600;
            padding: 12px 20px;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

        #send:hover {
            background: linear-gradient(to right, #5e00ca, #00388f);
        }
    </style>
</head>

<body>
    <!-- HEADER -->
    <div id="formbarHeader">
        <div id="headerLogo">
            <h1>Formchat</h1>
            <p>v 0.0.pirate</p>
        </div>
    </div>

    <!-- Main Content -->
    <main id="chat-container">
        <aside id="chat-sidebar">
            <h2>Chat Rooms</h2>
            <p style="font-size:14px;opacity:0.8;">(coming soon)</p>
        </aside>

        <section id="chat-main">
            <div id="messages">
                <div class="message">Hello there 👋</div>
                <div class="message you">Hey! Welcome to Formchat.</div>
            </div>
            <div id="inputBar">
                <input id="msg" type="text" placeholder="Type a message..." />
                <button id="send">Send</button>
            </div>
        </section>
    </main>

    <script>
        const USERNAME = "<%= username %>";
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/script.js"></script>
</body>

</html>