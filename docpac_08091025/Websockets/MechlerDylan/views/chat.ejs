<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chatroom</title>
    <style>
        #nameDisplay {
            border: 1px solid rgb(0, 0, 0);
            padding: 5px;
            height: 69px;
            margin-bottom: -1px;
        }

        #main {
            display: flex;
            width: 100%;
            height: 779px;

        }

        #message {
            display: inline-block;
            width: 80%;
            text-align: center;
            height: 776px;
        }

        #display {
            border: 1px solid rgb(0, 0, 0);
            height: 95%;
            overflow: auto;
        }

        #send {
            height: 2%;
            margin-top: -1px;
            display: flex;
        }

        #users {
            border: 1px solid rgb(0, 0, 0);
            width: 20%;
            text-align: center;
            height: 778px;
            margin-left: -1px;
            overflow: auto;
        }

        #text {
            width: 1200px;
            height: 36px;
            overflow: auto;
        }

        #sendMessage {
            width: 315px;
            height: 42px;
            margin-left: -5px;
            margin-right: -12px;
        }

        #displayedMessage {
            border-left: 1px solid rgb(0, 0, 0);
            border-top: 2px solid rgb(0, 0, 0);
            border-bottom: 2px solid rgb(0, 0, 0);
            height: auto;
            margin: -1px;
            width: 100%;
        }

        #sender {
            border-bottom: 1px solid rgb(0, 0, 0);
        }

        #name {
            border-bottom: 1px solid rgb(0, 0, 0);
            border-top: 1px solid rgb(0, 0, 0);
            font-size: 15px;
        }
    </style>
</head>

<body>
    <div id="nameDisplay">
        <h2>Welcome, <%-user%></h2>
    </div>
    <div id="main">
        <div id="message">
            <div id="display">
                <div id="displayedMessage">
                    <div id="sender">
                        User
                    </div>
                    <div id="sentMessage">
                        This is a message
                    </div>
                </div>
            </div>
            <div id="send">
                <form method="POST" action="/chat">
                    <input type="text" id="text" name="text" autocomplete="off" placeholder="Type Message Here">
                    <input type="submit" id="sendMessage" value="Send">
                </form>
            </div>
        </div>
        <div id="users">
            <div id="name">User</div>
        </div>
    </div>
</body>

</html>