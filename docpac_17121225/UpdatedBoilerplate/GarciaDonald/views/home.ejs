<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    WELCOME TO THE HOME PAGE
    <a href="login.ejs">Login</a>
</body>
<script>
    // if user isn't logged in, simply display login or signup links
    <%- if (!session.user) { %>
        window.location.href == "/login";
    <%- } %>
    // if user is logged in, display welcome message with username and profile link
    <%- if (session.user) { %>
        document.write('Welcome, <%= session.user.username %>! ');
        document.write('<a href="/profile">Profile</a>');
    <%- } %>
</script>
</html>