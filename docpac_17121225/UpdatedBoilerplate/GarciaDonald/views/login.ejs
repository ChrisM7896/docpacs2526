<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
body {
    font-family: Arial, sans-serif;
    text-align: center;
    margin-top: 50px;
}
h1 {
    font-size: 36px;
    margin-bottom: 20px;
    outline: black;
    outline-offset: 10px;
}
form {
    margin: 20px auto;
    width: 300px;
    display: flex;
    flex-direction: column;
}
</style>
<body>
    <h1>LOGIN</h1>
    
    <form action="/modules/auth/native.js" method="post">
        <input type="text" name="username" placeholder="Username" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit">Login with Username/Password</button>
    </form>

    <!-- OAuth login button -->
    <% if (typeof AUTH_URL !== 'undefined') { %>
        <button onclick="window.location.href='<%= AUTH_URL %>'">Login with OAuth</button>
    <% } %>

    <!-- Client-side redirect if already logged in -->
    <% if (session && session.user) { %>
        <script>
            window.location.href = "/";
        </script>
    <% } %>
    
    <!-- Show error message if login failed -->
    <% if (typeof loginError !== 'undefined' && loginError) { %>
        <script>
            alert("Login failed. Please try again.");
        </script>
    <% } %>
</body>
</html>