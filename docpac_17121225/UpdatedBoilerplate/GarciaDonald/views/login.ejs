<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>LOGIN</h1>
    <form action="input">username</form>
    <form action="input">password</form>

    // button for OAuth login
    <button onclick="window.location.href='<%= AUTH_URL %>'">Login with OAuth</button>

</body>
<script>
    // if user is already logged in, redirect to home page
    <%- if (session.user) { %>
        window.location.href = "/";
    <%- } %>
    // if the login failed, display an error message
    <%- if (typeof loginError !== 'undefined' && loginError) { %>
        alert("Login failed. Please try again.");
    <%- } %>
</script>
</html>