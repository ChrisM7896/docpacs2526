<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <style>
        body { 
            font-family: Arial, sans-serif; 
            max-width: 400px; 
            margin: 100px auto; 
            padding: 20px; 
        }
        .auth-section { 
            margin: 30px 0; 
            padding: 20px; 
            border: 1px solid #ddd; 
            border-radius: 5px; 
        }
        input, button { 
            width: 100%; 
            padding: 10px; 
            margin: 5px 0; 
            box-sizing: border-box; 
        }
        button { 
            background-color: #007bff; 
            color: white; 
            border: none; 
            cursor: pointer; 
        }
        button:hover { 
            background-color: #0056b3; 
        }
        .formbar-btn { 
            background-color: #28a745; 
        }
        .formbar-btn:hover { 
            background-color: #1e7e34; 
        }
        .error { 
            color: red; 
            margin: 10px 0; 
        }
    </style>
</head>
<body>
    <h1>Login</h1>
    
    <% if (error) { %>
        <div class="error"><%= error %></div>
    <% } %>
    
    <div class="auth-section">
        <h2>Login with Username & Password</h2>
        <form method="POST" action="/login">
            <input type="text" name="username" placeholder="Username" required>
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">Login</button>
        </form>
    </div>
    
    <div class="auth-section">
        <h2>Login with Formbar</h2>
        <a href="/login/formbar">
            <button type="button" class="formbar-btn">Login with Formbar OAuth</button>
        </a>
    </div>

    <!-- Add this section to your login.ejs -->
<div class="auth-section">
    <h2>Create Test Account</h2>
    <form method="POST" action="/register">
        <input type="text" name="username" placeholder="Choose Username" required>
        <input type="password" name="password" placeholder="Choose Password" required>
        <button type="submit" style="background-color: #6c757d;">Create Account</button>
    </form>
    <small>This is for testing - you can remove this later</small>
</div>
</body>
</html>
