<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Purchase Chips</title>
</head>
<body>
    <form action = "/add" method = "POST">
        <select name = "form">
            <option value = "Salted">Salted chips</option>
            <option value = "Cheddar cheese">Cheddar cheese chips</option>
            <option value = "Sour cream and onion">Sour cream and onion chips</option>
            <option value = "BBQ">BBQ chips</option>
        </select>
        <input type = "number" min = "1" name = "quantity">
        <button type = "submit">Order Chips</button>
    </form>
</body>
</html>