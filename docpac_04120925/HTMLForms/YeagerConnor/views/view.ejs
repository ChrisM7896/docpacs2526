<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders Placed</title>
</head>
<body>
    <% if (orders) { %>
    <ol>
        <% for (let order of orders) { %>
            <li><%= order.quantity %> <%= order.form %> </li>
        <% } %>
    </ol>
    <% } %>
</body>
</html>