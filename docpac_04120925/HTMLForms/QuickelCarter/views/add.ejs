<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forms - Add Entry</title>
</head>
<body>
    <a href="/">Back</a>
    <form id="newForm" action="/add" method="POST">
        <label for="name">Video Game:</label>
        <input type="text" id="name" name="name" required><br><br>
        <label for="rating">100% Completed: </label>
        <input type="checkbox" id="completion" name="completion"><br><br>
        <label for="rating">Gameplay: </label>
        <input type="range" id="gameplay" name="gameplay"><br><br>
        <label for="rating">Graphics: </label>
        <input type="range" id="graphics" name="graphics"><br><br>
        <label for="rating">Story: </label>
        <input type="range" id="story" name="story"><br><br>
        <label for="rating">100% Torture: </label>
        <input type="range" id="torture" name="torture"><br><br>
        <label for="rating">Rating (1-100):</label>
        <input type="number" id="rating" name="rating" required><br><br>
        <button type="submit">Add Entry</button>
</body>
<style>
    body {
        font-family: 'Courier New', Courier, monospace;
        background-color: #f0f2f5;
        padding: 20px;
    }
    a {
        display: inline-block;
        margin-bottom: 20px;
        text-decoration: none;
        color: #4CAF50;
        font-weight: bold;
    }
</style>
</html>