<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Response</title>
</head>

<body>
    <div id="filledData"></div>
    <a href="/">Home Page</a><br><br>
    <a href="/add">Add</a><br>
    <script>
        // Parse the JSON string back into an object
        var data = JSON.parse(`<%- JSON.stringify(data) %>`);
        console.log(data);

        const filledData = document.getElementById("filledData");
        data.forEach(item => {
            const div = document.createElement("div");
            div.innerHTML = `Name: ${item.userName} <br> Favorite Color: <span style="color:${item.favColor}">${item.favColor}</span><br><br>`;
            filledData.appendChild(div);
        });
    </script>
</body>

</html>