<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
</head>
<body>
    <h1></h1>ERROR:</h1>
</body>
<script>
    console.error("<%- message %>");
    document.querySelector("h1").innerText = "ERROR: <%- message %>";
</script>
</html>