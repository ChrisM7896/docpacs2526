<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>Food</h1>
    <% if (foods && foods.length> 0) { %>
            <% foods.forEach(foods=> { %>
                <li>
                    food: <%= foods.food %>, healthy: <%= foods.healthy %>
                </li>
                <% }) %>
        <% } else { %>
            <p>No food submitted</p>
            <% } %>
                <a href="/">Back to Home</a>
</body>

</html>