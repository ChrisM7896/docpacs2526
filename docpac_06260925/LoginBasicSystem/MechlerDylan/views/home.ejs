<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <style>
        body {
            background-color: #000000;
            font-family: Georgia, 'Times New Roman', Times, serif;
            color: rgb(0, 255, 0);
        }

        #container {
            display: flex;
            flex-direction: column;
            width: 300px;
            margin: 100px auto;
            margin-top: 50px;
            padding: 20px;
            border: 1px solid rgb(0, 125, 0);
            border-radius: 5px;
            border-width: 2px;
            background-color: #000000;
        }

        #header {
            display: flex;
            justify-content: center;
            margin-top: 150px;
            text-align: center;
            font-size: 40px;
            color: rgb(0, 255, 0);
            cursor: default;
        }

        #displayUsername, #displayEmail {
            margin-bottom: 15px;
            padding: 8px;
            background-color: #000000;
            color: rgb(0, 255, 0);
            font-size: 16px;
        }

        #title {
            font-weight: bold;
            color: rgb(0, 255, 0);
            font-size: 20px;
            margin-bottom: 10px;
            text-align: center;
        }

        #content {
            border: rgb(0, 255, 0) 1px solid;
            border-radius: 3px;
            text-align: center;
            font-size: 16px;
            color: rgb(0, 255, 0);
            padding: 8px;
            background-color: #000000;
        }

        #linkbox {
            display: flex;
            justify-content: center;
        }

        #home {
            display: flex;
            justify-content: center;
            width: 100px;
            height: 40px;
            line-height: 40px;
            margin: 10px;
            padding: 10px 20px;
            background-color: #000000;
            color: rgb(0, 255, 0);
            text-decoration: none;
            border: rgb(0, 125, 0) 2px solid;
            border-radius: 5px;
            transition: background-color 0.3s ease;
            font-size: 20px;
            box-shadow: rgb(0, 150, 0) 2px 2px 5px;
            font-family:Georgia, 'Times New Roman', Times, serif;
            cursor: pointer;
        }

        #home:hover {
            background-color: rgb(25, 25, 25);
            border: rgb(0, 200, 0) 2px solid;
            box-shadow: rgb(0, 255, 0) 2px 2px 5px;
            transform: scale(1.05);
        }

        @keyframes backgroundPulse {
            0% {
                background-color: rgb(0, 0, 0);
            }
            50% {
                background-color: rgb(0, 50, 0);
            }
            100% {
                background-color: rgb(0, 100, 0);
            }

            50% {
                background-color: rgb(0, 50, 0);
            }

            100% {
                background-color: rgb(0, 0, 0);
            }
        }

        body {
            animation: backgroundPulse 5s infinite;
        }
    </style>
</head>

<body>
    <h1 id="header">Home</h1>
    <div id="container">
        <div id="displayUsername"><div id="title">Username: </div><br><br> <div id="content"><%- username %></div></div><br><br>
        <div id="displayEmail"><div id="title">Email: </div><br><br> <div id="content"><%- email %></div></div><br><br>
        <div id="linkbox"><a href="/" id="home">Main Page</a></div>
    </div>
</body>

</html>