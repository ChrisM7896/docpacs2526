<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Basic System</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #000000;
            font-family: Arial, sans-serif;
        }

        #links {
            text-align: center;
        }

        #link {
            display: inline-block;
            width: 200px;
            height: 80px;
            line-height: 80px;
            margin: 10px;
            padding: 10px 20px;
            background-color: #000000;
            color: rgb(0, 255, 0);
            text-decoration: none;
            border: rgb(0, 125, 0) 2px solid;
            border-radius: 5px;
            transition: background-color 0.3s ease;
            font-size: 40px;
            box-shadow: rgb(0, 150, 0) 2px 2px 5px;
            font-family:Georgia, 'Times New Roman', Times, serif;
            cursor: pointer;
        }

        #link:hover {
            background-color: rgb(25, 25, 25);
            border: rgb(0, 200, 0) 2px solid;
            box-shadow: rgb(0, 255, 0) 2px 2px 5px;
            transform: scale(1.05);
        }

        #header {
            margin-bottom: 20px;
            font-size: 80px;
            color: rgb(0, 255, 0);
            font-family: Georgia, 'Times New Roman', Times, serif;
            cursor: default;
        }
        
        @keyframes backgroundPulse {
            0% {
                background-color: rgb(0, 0, 0);
            }
            50% {
                background-color: rgb(0, 50, 0);
            }
            100% {
                background-color: rgb(0, 100, 0);
            }

            50% {
                background-color: rgb(0, 50, 0);
            }

            100% {
                background-color: rgb(0, 0, 0);
            }
        }

        body {
            animation: backgroundPulse 5s infinite;
        }
    </style>
</head>

<body>
    <div>
        <h1 id="header">Login Basic System</h1>
        <div id="links">
            <a href="/login" id="link">Login</a><br>
            <a href="/signup" id="link">Signup</a>
        </div>
    </div>
</body>

</html>