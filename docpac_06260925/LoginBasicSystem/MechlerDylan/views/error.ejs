<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <style>
        body {
            background-color: #000000;
            font-family: Georgia, 'Times New Roman', Times, serif;
            color: rgb(0, 255, 0);
        }

        a {
            display: flex;
            justify-content: center;
            width: 300px;
            height: 120px;
            line-height: 120px;
            margin: 10px;
            padding: 10px 20px;
            background-color: #000000;
            color: rgb(0, 255, 0);
            text-decoration: none;
            border: rgb(0, 125, 0) 2px solid;
            border-radius: 5px;
            transition: background-color 0.3s ease;
            font-size: 60px;
            box-shadow: rgb(0, 150, 0) 2px 2px 5px;
            font-family:Georgia, 'Times New Roman', Times, serif;
            cursor: pointer;
        }

        a:hover {
            background-color: rgb(25, 25, 25);
            border: rgb(0, 200, 0) 2px solid;
            box-shadow: rgb(0, 255, 0) 2px 2px 5px;
            transform: scale(1.05);
        }

        div {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        @keyframes backgroundPulse {
            0% {
                background-color: rgb(0, 0, 0);
            }
            50% {
                background-color: rgb(0, 50, 0);
            }
            100% {
                background-color: rgb(0, 100, 0);
            }

            50% {
                background-color: rgb(0, 50, 0);
            }

            100% {
                background-color: rgb(0, 0, 0);
            }
        }

        body {
            animation: backgroundPulse 5s infinite;
        }
    </style>
</head>

<body>
    <div>
        <a href="/">Main Page</a>
    </div>
</body>

<script>
    alert("Error");
</script>

</html>