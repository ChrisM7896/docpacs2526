<body id="page">

    <!-- How does this code work and how did I not see it before??? -->
    <div id="title">This is an Error Page</h1>
        <p>
            <%= title %>: <%= message %>
        </p>
        <div id="links">
            <a href="/">Back to Home</a>
        </div>
</body>

</html>