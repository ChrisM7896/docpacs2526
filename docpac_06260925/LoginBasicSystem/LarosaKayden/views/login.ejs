<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        #links {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 10px;
            color: white;
            font-size: 16px;
            background-color: white;
        }

        #title {
            color: white;
            font-size: 100px;
            position: absolute;
            top: 20%;
        }

        #page {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: row;
            height: 100vh;
            background-color: black;
            overflow: hidden;
        }

        #form {
            color: white;
            font-size: 20px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .form-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        label {
            width: 100px;
            text-align: right;
        }

        input {
            flex: 1;
        }

        #formblock1 {
            display: inline-block;
            flex-direction: row;
        }

        #formblock2 {
            display: inline-block;
            flex-direction: row;
        }
    </style>
</head>

<div id="links">
    <a href="/">Back to Home</a>
    <a href="/signup">Sign Up</a>
</div>

<body id="page">
    <div id="title">This is a Login Page</div>
    <div id="form">
        <form action="/login" method="POST">
            <div id="formblock1">
                <label for="username">Username:</label>
                <label for="email">Email:</label>
                <label for="password">Password:</label>
            </div>
            <div id="formblock2">
                <input type="text" id="username" name="username" required><br><br>
                <input type="email" id="email" name="email" required><br><br>
                <input type="password" id="password" name="password" required><br><br>
            </div>
            <button type="submit">Login</button>
    </div>
</body>

</html>