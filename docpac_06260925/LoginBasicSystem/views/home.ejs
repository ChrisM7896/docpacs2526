<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bob</title>
</head>
<body>
    <h1>Your user and email!</h1>
    <div id="une"></div>

    <script>
