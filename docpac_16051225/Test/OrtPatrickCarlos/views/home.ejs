<%- include('partials/header', { title: 'Home', loggedIn: loggedIn }) %>
<main>
  <h1>Welcome to the Node Boilerplate</h1>
  <% if (loggedIn) { %>
    <p>Hello, <strong><%= user.username %></strong> — <a href="/profile">View profile</a></p>
  <% } else { %>
    <p>You are not logged in. <a href="/login">Log in</a></p>
  <% } %>
</main>
<%- include('partials/footer') %>
