<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        #page {
            background-color: black;
            margin: 0;
            justify-content: center;
            align-items: center;
            color: white;
            height: 100vh;
            background-image: url();
            background-size: auto 100vh;
            background-repeat: no-repeat;
            background-position: center;
            overflow: hidden;
        }

        #title {
            margin-top: 10px;
            font-size: 50px;
            top: 10%;
            text-align: center;
        }

        #dataBox {
            margin-top: 20px;
            font-size: 20px;
            text-align: center;
            color: #ffffff;
        }

        #form {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;

        }

        .form-group {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        label {
            width: 100px;
            text-align: right;
            margin-right: 10px;
            font-size: 20px;
        }

        input {
            flex: 1;
            padding: 5px;
            box-sizing: border-box;
        }

        button {
            margin-top: 10px;
        }
    </style>
</head>

<body id="page">
    <div id="title">Hello, <%= user %>
    </div>
    <div id="form">
        <form action="/profile" method="POST">
            <div class="form-group">
                <label>Profile Checked?</label>
                <input type="checkbox" id="profile_checked" name="profile_checked">
                <button type="submit">Save</button>
            </div>
        </form>
    </div>
    <script>
        var profile_checked = `<%= profile_checked %>`;
        console.log(profile_checked);
        var checkbox = document.getElementById('profile_checked');
        checkbox.checked = profile_checked;
    </script>
</body>

</html>