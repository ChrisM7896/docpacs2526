<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hame Page</title>
    <style>
        #page {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            height: 100vh;
            background-color: black;
            color: white;
            overflow: hidden;
        }

        #title {
            color: white;
            font-size: 100px;
            top: 10%;
            text-align: center;
        }

        #links {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 10px;
            color: white;
            font-size: 16px;
        }

        #links a:visited {
            color: white;
        }

        #links a {
            color: white;
        }
    </style>
</head>

<body id="page">
    <div id="title">Welcome to the Home Page</div>
    <div id="links">
        <a href="/login">Go to Login</a>
        <a href="/profile">Go to Profile</a>
    </div>

</body>

</html>