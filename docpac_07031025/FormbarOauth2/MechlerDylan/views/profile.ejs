<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
</head>

<body>
    <div id="checkForm">
        <h1 id="header"><%- user %></h1>
        <form method="POST" action="/profile">
            <label for="userCheck">Check Profile</label><br>
            <input type="checkbox" id="userCheck" name="userCheck"><br><br>
            <input type="submit" value="Submit">
        </form>
    </div>

    <script>
        var check = JSON.parse(`<%- check%>`)
        console.log(check)
        checkBox = document.getElementById('userCheck')
        checkBox.checked = check
        console.log(checkBox.checked)
    </script>
</body>

</html>