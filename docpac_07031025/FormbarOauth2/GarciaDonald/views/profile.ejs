<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile</title>
</head>
<body>
    <h1>Profile Page</h1>
    <p>Welcome, <%= user %>!</p>
    <form action="/profile" method="POST">
        <label for="profile">Checkbox:</label>
        <input type="checkbox" id="checkers" name="profileChecked">
        <button type="submit">Submit</button>
    <a href="/">Logout</a>

    <script>
        var checkers = document.getElementById('checkers');
        var check = `<%- check %>`;
        console.log('check value from server:', check, checkers.checked);
        checkers.checked = check;
    </script>
</body>
</html>