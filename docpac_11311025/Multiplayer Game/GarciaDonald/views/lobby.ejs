<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
    body {
        font-family: Arial, sans-serif;
        text-align: center;
        margin-top: 50px;
    }
    p {
        font-size: 20px;
        color: aquamarine;
    }
</style>
<body>
    <h1>Welcome to the Lobby</h1>
    <p>Waiting for other players to join...</p>
</body>
<script>
    // Placeholder for multiplayer lobby functionality
    const socket = io();
    let playerCount = 1; // This would be updated based on real player joins
    const requiredPlayers = 2; // Example required players to start the game

    socket.on('playerJoined', (data) => {
        console.log(`${data.username} has joined the lobby.`);
        playerCount++;
        // Update lobby UI accordingly
    });
    socket.on('playerLeft', (data) => {
        console.log(`${data.username} has left the lobby.`);
        playerCount--;
        // Update lobby UI accordingly
    });
    if (playerCount >= requiredPlayers) {
        // Start the multiplayer game
        window.location.href = '/multigame';

    }
</script>
</html>