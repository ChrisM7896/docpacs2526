<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Game</title>
    <style>
        #content {
            display: flex;
        }

        #spells {
            margin: 5px;
        }

        #weaknesses {
            margin: 5px;
        }

        button {
            width: 100px;
            height: 100px;
        }
    </style>
</head>

<body>
    <div id="content">
        <div id="spells">
            <h1>Spells:</h1>
            <button onclick="castSpell(1)">Fire</button>
            <button onclick="castSpell(2)">Water</button>
            <button onclick="castSpell(3)">Lightning</button>
            <button onclick="castSpell(4)">Earth</button>
            <button onclick="castSpell(5)">Air</button>
        </div>
        <div id="weaknesses">
            <h1>Weaknesses:</h1>
            <div>Fire to Water</div>
            <div>Water to Lightning</div>
            <div>Lightning to Earth</div>
            <div>Earth to Air</div>
            <div>Air to Fire</div>
        </div>
    </div>
</body>
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const content = document.getElementById("spells");
    var playState = true;

    function castSpell(spell) {
        playState = false
        content.innerHTML = ''
        socket.emit('spell', spell);
    };

    socket.on('connected', () => {
        console.log('connected')
        socket.emit('playState', playState);
    });

    socket.on('playable', () => {
        console.log('playable')
        playState = false
        content.innerHTML = ''
    });
</script>

</html>