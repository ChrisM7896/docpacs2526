        function update() {

            if (keyWDown || keySDown) {
                avatar.velocityY += 0.2 * inputVertical
            }
            if (keyADown || keyDDown) {
                avatar.velocityX += 0.2 * inputHorizontal
            }
            if (!keyWDown && !keySDown) {
                if (avatar.velocityY > 0.1) {
                    avatar.velocityY -= 0.1
                } else if (avatar.velocityY < -0.1) {
                    avatar.velocityY += 0.1
                } else {
                    avatar.velocityY = 0
                }
            }
            if (!keyADown && !keyDDown) {
                if (avatar.velocityX > 0.1) {
                    avatar.velocityX -= 0.1
                } else if (avatar.velocityX < -0.1) {
                    avatar.velocityX += 0.1
                } else {
                    avatar.velocityX = 0
                }
            }
            if (avatar.velocityX < avatar.minVelocity) {
                avatar.velocityX = avatar.minVelocity;
            } else if (avatar.velocityX > avatar.maxVelocity) {
                avatar.velocityX = avatar.maxVelocity;
            }
            if (avatar.velocityY < avatar.minVelocity) {
                avatar.velocityY = avatar.minVelocity;
            } else if (avatar.velocityY > avatar.maxVelocity) {
                avatar.velocityY = avatar.maxVelocity;
            }
            avatar.x += avatar.playerSpeed * avatar.velocityX;
            avatar.y += avatar.playerSpeed * avatar.velocityY;
            if (avatar.x < 0) {
                avatar.deadPork = true;
            } else if (avatar.y < 0) {
                avatar.deadPork = true;
            } else if (avatar.x + avatar.w > canvas.width) {
                avatar.deadPork = true;
            } else if (avatar.y + avatar.h > canvas.height) {
                avatar.deadPork = true;
            }

            document.getElementById('position').innerText = `Player X: ${avatar.x} Player Y: ${avatar.y}`;
            ctx.fillStyle = 'pink';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            if (!avatar.deadPork) {
                ctx.drawImage(avatar.img, avatar.x, avatar.y, avatar.w, avatar.h);
            }
        }

        function update2() {
            // Player 2
            if (keyWDown2 || keySDown2) {
                avatar2.velocityY += 0.2 * inputVertical2
            }
            if (keyADown2 || keyDDown2) {
                avatar2.velocityX += 0.2 * inputHorizontal2
            }
            if (!keyWDown2 && !keySDown2) {
                if (avatar2.velocityY > 0.1) {
                    avatar2.velocityY -= 0.1
                } else if (avatar2.velocityY < -0.1) {
                    avatar2.velocityY += 0.1
                } else {
                    avatar2.velocityY = 0
                }
            }
            if (!keyADown2 && !keyDDown2) {
                if (avatar2.velocityX > 0.1) {
                    avatar2.velocityX -= 0.1
                } else if (avatar2.velocityX < -0.1) {
                    avatar2.velocityX += 0.1
                } else {
                    avatar2.velocityX = 0
                }
            }
            if (avatar2.velocityX < avatar2.minVelocity) {
                avatar2.velocityX = avatar2.minVelocity;
            } else if (avatar2.velocityX > avatar2.maxVelocity) {
                avatar2.velocityX = avatar2.maxVelocity;
            }
            if (avatar2.velocityY < avatar2.minVelocity) {
                avatar2.velocityY = avatar2.minVelocity;
            } else if (avatar2.velocityY > avatar2.maxVelocity) {
                avatar2.velocityY = avatar2.maxVelocity;
            }
            avatar2.x += avatar2.playerSpeed * avatar2.velocityX;
            avatar2.y += avatar2.playerSpeed * avatar2.velocityY;
            if (avatar2.x < 0) {
                avatar2.deadPork = true;
            } else if (avatar2.y < 0) {
                avatar2.deadPork = true;
            } else if (avatar2.x + avatar2.w > canvas.width) {
                avatar2.deadPork = true;
            } else if (avatar2.y + avatar2.h > canvas.height) {
                avatar2.deadPork = true;
            }

            document.getElementById('position2').innerText = `avatar2 X: ${avatar2.x} avatar2 Y: ${avatar2.y}`;
            if (!avatar2.deadPork) {
                ctx.drawImage(avatar2.img, avatar2.x, avatar2.y, avatar2.w, avatar2.h);
            }
        }

        function checkCollision(avatar, avatar2) {
            return (
                avatar.x < avatar2.x + avatar2.w &&
                avatar.x + avatar.w > avatar2.x &&
                avatar.y < avatar2.y + avatar2.h &&
                avatar.y + avatar.h > avatar2.y
            );
        }

        function handleCollision(avatar, avatar2) {

            const dx = (avatar.x + avatar.w / 2) - (avatar2.x + avatar2.w / 2);
            const dy = (avatar.y + avatar.h / 2) - (avatar2.y + avatar2.h / 2);


            if (Math.abs(dx) > Math.abs(dy)) {
                avatar.velocityX *= -1.05;
                avatar2.velocityX *= -1.05;
            } else {
                avatar.velocityY *= -1.05;
                avatar2.velocityY *= -1.05;
            }

            if (checkCollision(avatar, avatar2)) {
                avatar.x += avatar.velocityX;
                avatar.y += avatar.velocityY;
                avatar2.x += avatar2.velocityX;
                avatar2.y += avatar2.velocityY;
            }
        }

        function gameLoop() {
            update();
            update2();
            if (checkCollision(avatar, avatar2)) {
                handleCollision(avatar, avatar2);
            }
            requestAnimationFrame(gameLoop);
        }
        gameLoop();

    </script>
