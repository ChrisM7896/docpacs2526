<body>
    <div id="controls">Control Method: Keyboard</div>
    <div id="position">avatar X: avatar Y: </div>
    <div id="position2">avatar2 X: avatar2 Y: </div>
    <canvas width="1400" height="700"></canvas>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        let myPlayer = null;
        let myAvatar = null;

        socket.on('assignPlayer', (data) => {
            myPlayer = data.player;

            if (myPlayer === 'player1') {
                myAvatar = avatar;
                console.log("You are controlling Player 1");
            } else if (myPlayer === 'player2') {
                myAvatar = avatar2;
                console.log("You are controlling Player 2");
            }
        });
        const avatar = {
            x: 314,
            y: 366,
            w: 50,
            h: 50,
            img: new Image(),
            playerSpeed: 1,
            velocityX: 0,
            velocityY: 0,
            minVelocity: -5,
            maxVelocity: 5,
            deadPork: false
        }

        const avatar2 = {
            x: 720,
            y: 366,
            w: 50,
            h: 50,
            img: new Image(),
            playerSpeed: 1,
            velocityX: 0,
            velocityY: 0,
            minVelocity: -5,
            maxVelocity: 5,
            deadPork: false
        }

        const canvas = document.querySelector('canvas');
        const ctx = canvas.getContext('2d');

        var inputVertical = 0;
        var inputHorizontal = 0;
        var keyWDown = false;
        var keyADown = false;
        var keySDown = false;
        var keyDDown = false;

        var inputVertical2 = 0;
        var inputHorizontal2 = 0;
        var keyWDown2 = false;
        var keyADown2 = false;
        var keySDown2 = false;
        var keyDDown2 = false;

        avatar.img.src = 'Hog.png';
        avatar2.img.src = 'DeadHog.png';

        document.addEventListener('keydown', (key) => {
            switch (key.key) {
                case 'w':
                    inputVertical = -1;
                    keyWDown = true;
                    document.getElementById('position').innerText = `Player X: ${avatar.x} Player Y: ${avatar.y}`;
                    break;
                case 'a':
                    inputHorizontal = -1;
                    keyADown = true;
                    document.getElementById('position').innerText = `Player X: ${avatar.x} Player Y: ${avatar.y}`;
                    break;
                case 's':
                    inputVertical = 1;
                    keySDown = true;
                    document.getElementById('position').innerText = `Player X: ${avatar.x} Player Y: ${avatar.y}`;
                    break;
                case 'd':
                    inputHorizontal = 1;
                    keyDDown = true;
                    document.getElementById('position').innerText = `Player X: ${avatar.x} Player Y: ${avatar.y}`;
                    break;
            }
        });

        document.addEventListener('keyup', (key) => {
            switch (key.key) {
                case 'w':
                    keyWDown = false;
                    break;
                case 'a':
                    keyADown = false;
                    break;
                case 's':
                    keySDown = false;
                    break;
                case 'd':
                    keyDDown = false;
                    break;
            }
        })

        document.addEventListener('keydown', (key) => {
            switch (key.key) {
                case 'i':
                    inputVertical2 = -1;
                    keyWDown2 = true;
                    document.getElementById('position2').innerText = `avatar2 X: ${avatar.x} avatar2 Y: ${avatar.y}`;
                    break;
                case 'j':
                    inputHorizontal2 = -1;
                    keyADown2 = true;
                    document.getElementById('position2').innerText = `avatar2 X: ${avatar.x} avatar2 Y: ${avatar.y}`;
                    break;
                case 'k':
                    inputVertical2 = 1;
                    keySDown2 = true;
                    document.getElementById('position2').innerText = `avatar2 X: ${avatar.x} avatar2 Y: ${avatar.y}`;
                    break;
                case 'l':
                    inputHorizontal2 = 1;
                    keyDDown2 = true;
                    document.getElementById('position2').innerText = `avatar2 X: ${avatar.x} avatar2 Y: ${avatar.y}`;
                    break;
            }
        });

        document.addEventListener('keyup', (key) => {
            switch (key.key) {
                case 'i':
                    keyWDown2 = false;
                    break;
                case 'j':
                    keyADown2 = false;
                    break;
                case 'k':
                    keySDown2 = false;
                    break;
                case 'l':
                    keyDDown2 = false;
                    break;
            }
        })

