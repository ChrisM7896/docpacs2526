<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
</body>
</html>
<div class="post">
    <h1><%= post.title %></h1>
    <p><%= post.content %></p>
    <p><em>Posted by <%= post.author %> on <%= post.date %></em></p>
</div>

<div class="comments">
    <h2>Comments</h2>
    <% post.comments.forEach(function(comment) { %>
        <div class="comment">
            <p><strong><%= comment.author %>:</strong> <%= comment.content %></p>
        </div>
    <% }); %>
</div>