<!DOCTYPE html>
<html>
<head>
    <title>Post Board</title>
</head>
<body>
    <h1>Welcome, <%= user.username %>!</h1>
    <h2>All Posts</h2>
    <ul>
        <% posts.forEach(post => { %>
            <li>
                <h3><%= post.title %></h3>
                <p><%= post.description %></p>
                <p>Posted by <%= post.username %> on <%= new Date(post.timestamp).toLocaleString() %></p>
            </li>
        <% }) %>
    </ul>
</body>
</html>