<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
</body>
</html>
<h1>User Profile</h1>
<div class="user-profile">
    <h2>Posts by User</h2>
    <ul>
        <% posts.forEach(post => { %>
            <li>
                <h3><%= post.title %></h3>
                <p><%= post.content %></p>
                <p><em>Posted on: <%= post.date %></em></p>
            </li>
        <% }); %>
    </ul>
</div>