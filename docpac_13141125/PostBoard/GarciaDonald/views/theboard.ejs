<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    JOBS:
    <ul>
        <% jobs.forEach(function(job) { %>
            <li><strong><%= job.title %></strong> - <%= job.description %> (Posted by: <%= job.postedBy %>)</li>
        <% }); %>
    </ul>
</body>
<script>
    posts = <%- JSON.stringify(posts) %>;
    console.log(posts);
    jobs = posts;
    console.log(jobs);
    // You can now use the 'jobs' variable in your JavaScript code
    jobs.forEach(function(job) {
        console.log("Job Title: " + job.title + ", Description: " + job.description + ", Posted by: " + job.postedBy);
    });
</script>
</html>