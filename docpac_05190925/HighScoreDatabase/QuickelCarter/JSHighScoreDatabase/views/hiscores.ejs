<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scores</title>
</head>
<body>
    <a href="/" style="position: absolute; top: 10px; left: 10px; text-decoration: none; color: white; font-size: 20px;">&#8592; Back</a>
    <h1 style="color: white; text-align: center;">High Scores</h1>
    <table style="width: 50%; margin: auto; border-collapse: collapse; color: white;">
        <thead>
            <tr>
                <th style="border: 1px solid white; padding: 8px;">Rank</th>
                <th style="border: 1px solid white; padding: 8px;">User</th>
                <th style="border: 1px solid white; padding: 8px;">Score</th>
            </tr>
        </thead>
        <tbody>
            <% scores.forEach((score, index) => { %>
                <tr>
                    <td style="border: 1px solid white; padding: 8px; text-align: center;"><%= index + 1 %></td>
                    <td style="border: 1px solid white; padding: 8px; text-align: center;"><%= score.name %></td>
                    <td style="border: 1px solid white; padding: 8px; text-align: center;"><%= score.score %></td>
                </tr>
            <% }) %>
        </tbody>
</body>
<style>
    body {
        background-color: #332e2e;
        margin-top: 50px;
        padding: 20px;
    }
</style>
</html>