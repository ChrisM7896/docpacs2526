<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hiscores</title>
</head>

<body>
    <h1>Hiscores</h1>
    <div id="hiscoreList"></div>
    <script>
        var highscores = JSON.parse(`<%- scores %>`);
        console.log(highscores);

        const scorelist = document.getElementById("hiscoreList");
        for (i in highscores) {
            const div = document.createElement("div");
            div.innerHTML = `<b>${parseInt(i)+1}.</b> <b>Name:</b> ${highscores[i].name} <b>Score:</b> ${highscores[i].score}</span><br><br>`;
            scorelist.appendChild(div);
        };

    </script>
</body>

</html>