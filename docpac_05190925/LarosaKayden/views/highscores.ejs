<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HighScores</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: row;
            height: 100vh;
            background-color: black;
            overflow: hidden;
        }

        #links {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 10px;
            color: white;
            font-size: 16px;
            background-color: white;
        }

        .score-item {
            margin: 10px;
            padding: 5px;
        }
    </style>
</head>

<body>
    <div id="links">
        <a href="/">Home</a>
        <a href="game">Game</a>
    </div>
    <h1 style="color: white; position: absolute; height: 100%; font-size: 90px;">The Board of Leaders High Scorecerer's
    </h1>
    <ol style="color: white; font-size: 20px; border: 10px solid white; width: 900px;"></ol>
    <script>
        var highscores = JSON.parse(`<%- highscores %>`);
        console.log(highscores);
        highscores.forEach(score => {
            var li = document.createElement("li");
            li.textContent = score.name + ": " + score.score;
            li.className = "score-item";
            document.querySelector("ol").appendChild(li);
        });
    </script>
</body>

</html>