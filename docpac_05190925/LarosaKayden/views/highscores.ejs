<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HighScores</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: row;
            height: 100vh;
            background-color: black;
            overflow: hidden;
        }

        #links {
            position: absolute;
            top: 10px;
            left: 10px;
            padding: 10px;
            color: white;
            font-size: 16px;
            background-color: white;
        }
    </style>
</head>

<body>
    <div id="links">
        <a href="/">Home</a>
        <a href="game">Game</a>
    </div>
    <h1 style="color: white;">The boards of leaders High Scorcerer's</h1>
    <ol style="color: white; font-size: 20px; border: 10px solid white;">
        <% highscores.forEach(score=> { %>
            <li style="border: 1px solid white;">
                <%= score.username %> — <%= score.score %>
            </li>
            <% }) %>
    </ol>

</body>

</html>